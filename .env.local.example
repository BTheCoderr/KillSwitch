# Copy to ".env.local" in the project root and fill in real values.
# Next.js loads .env.local automatically; it is gitignored — never commit secrets.
#
# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — powers POST /api/waitlist inserts. NEVER prefix with NEXT_PUBLIC_ or expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional ---
# ANTHROPIC_API_KEY=sk-ant-...

# Twitch bot scripts (not required by Next app routes)
# TWITCH_BOT_USERNAME=your-bot-username
# TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWITCH_CHANNEL=your-channel-name
