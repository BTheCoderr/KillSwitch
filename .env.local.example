# --- Required for MVP ---
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional / post-launch ---
# Set when you swap /api/commentary for a real LLM call
# ANTHROPIC_API_KEY=sk-ant-...

# Used by scripts/twitch-bot/ (tmi.js) — not needed by the Next app itself
# TWITCH_BOT_USERNAME=your-bot-username
# TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWITCH_CHANNEL=your-channel-name
# Supabase service role (server-side bot only — never expose to the client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
